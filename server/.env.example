NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=./data/openresearcher.db

# JWT Authentication — MUST be changed in production
JWT_SECRET=your-secure-secret-key-change-this-in-production
JWT_EXPIRY=7d

# n8n MCP Server — all research operations go through this endpoint
# The JWT is kept server-side ONLY — never sent to the browser
N8N_MCP_ENDPOINT=https://n8n-aimpact.up.railway.app/mcp-server/http
N8N_JWT_TOKEN=<your-n8n-jwt-token-here>

# n8n Push Callback Secret (reserved for future push-notification mode)
# Generate with: openssl rand -hex 32
N8N_CALLBACK_SECRET=

# CORS
CORS_ORIGIN=http://localhost:3000
